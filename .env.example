# 数据库配置（连接 TeslaMate 数据库）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teslamate
DB_USER=teslamate
DB_PASSWORD=teslamate

# MQTT 配置
ENABLE_MQTT=true
MQTT_URL=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# 定时任务配置
ENABLE_CRON=true
DAILY_CRON=0 8 * * *
WEEKLY_CRON=0 9 * * 1
MONTHLY_CRON=0 9 1 * *

# Bark 推送配置
BARK_URL=https://api.day.app
BARK_KEY=your_bark_key

# 天气服务（可选）
# CAIYUN_TOKEN=your_caiyun_token

# 车辆配置
CAR_ID=1
MIN_TRIP_DISTANCE=1

# 时区
TZ=Asia/Shanghai
