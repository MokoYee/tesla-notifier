# Bark 推送
BARK_KEY=your_bark_key
BARK_URL=https://api.day.app
# GRAFANA_BASE_URL=https://grafana.example.com

# TeslaMate 数据库
# 默认适配 TeslaMate 标准 docker-compose 服务名
DB_HOST=database
DB_PORT=5432
DB_NAME=teslamate
DB_USER=teslamate
DB_PASSWORD=teslamate

# TeslaMate MQTT
ENABLE_MQTT=true
MQTT_URL=mqtt://mosquitto:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# 定时任务
ENABLE_CRON=true
DAILY_CRON=0 8 * * *
WEEKLY_CRON=0 9 * * mon
MONTHLY_CRON=0 9 1 * *

# 车辆与通用配置
CAR_ID=1
MIN_TRIP_DISTANCE=1
TZ=Asia/Shanghai

# 可选：天气与地址增强
# AMAP_KEY=your_amap_key

# 可选：实时提醒
# SENTRY_NOTIFY_ENABLED=ON
# DEPARTURE_SAFETY_NOTIFY_ENABLED=ON
# TPMS_NOTIFY_ENABLED=ON
# CHARGING_ISSUE_NOTIFY_ENABLED=ON

# 可选：路况增强（依赖 AMAP_KEY）
# TRAFFIC_ANALYSIS_ENABLED=ON

# 说明：
# 1. 弱网行程补偿默认已启用，一般无需额外配置
# 2. 系统健康通知默认已启用，一般无需额外配置
# 3. 更多环境变量说明请参考 docs/environment.md
