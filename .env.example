# 数据库配置（连接 TeslaMate PostgreSQL）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teslamate
DB_USER=teslamate
DB_PASSWORD=teslamate

# MQTT 配置（布尔值使用 true/false）
ENABLE_MQTT=true
MQTT_URL=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# 定时任务配置（布尔值使用 true/false）
ENABLE_CRON=true
# 每天早上 8 点推送日报
DAILY_CRON=0 8 * * *
# 每周一上午 9 点推送周报
WEEKLY_CRON=0 9 * * mon
# 每月 1 号上午 9 点推送月报
MONTHLY_CRON=0 9 1 * *

# Bark 推送配置
# 或自建 http://bark:8080
BARK_URL=https://api.day.app
BARK_KEY=your_bark_key
# 自定义推送图标（可选）
# BARK_ICON=https://your-custom-icon-url.png

# 天气服务（可选，不配置则使用免费的 Open-Meteo）
# 申请地址：https://platform.caiyunapp.com/application/manage
# CAIYUN_TOKEN=your_caiyun_token

# 高德地图（可选）
# 申请地址: https://console.amap.com/dev/key/app
AMAP_KEY=your_amap_key

# 车辆配置
CAR_ID=1
# 最小行程距离（km），过滤短行程
MIN_TRIP_DISTANCE=1

# 时区
TZ=Asia/Shanghai

# 状态文件路径（可选，用于持久化已推送记录）
# STATE_FILE=./data/state.json

# 哨兵录制提醒（开关使用 ON/OFF）
# SENTRY_NOTIFY_ENABLED=ON
# SENTRY_RECORDING_COOLDOWN=300

# 离车安全提醒（开关使用 ON/OFF）
# DEPARTURE_SAFETY_NOTIFY_ENABLED=ON
# DEPARTURE_SAFETY_DELAY=45

# 胎压异常提醒（开关使用 ON/OFF）
# TPMS_NOTIFY_ENABLED=ON
# TPMS_NOTIFY_COOLDOWN=1800

# 充电异常提醒（开关使用 ON/OFF）
# CHARGING_ISSUE_NOTIFY_ENABLED=ON
# CHARGING_ISSUE_COOLDOWN=900
# 当充电状态变为 Stopped 且距离上限仍大于该阈值时，判定为异常中断
# CHARGING_STOPPED_MIN_SOC_GAP=3

# 日志级别（可选：DEBUG / INFO / WARNING / ERROR）
# LOG_LEVEL=INFO
